# ====================================================================
# Meta Graph API Credentials (for Instagram Publishing)
# ====================================================================
# Obtain from Meta for Developers: https://developers.facebook.com/
# Long-lived Page Access Token with instagram_basic & instagram_content_publish scopes
IG_ACCESS_TOKEN=your_meta_graph_api_access_token_here

# Instagram Business Account ID
IG_USER_ID=your_instagram_business_account_id_here

# ====================================================================
# Branding & Publishing Defaults (Optional)
# ====================================================================
DEFAULT_BRAND_HANDLE=@yourpublication
DEFAULT_FOOTER_AUTHOR=@yourpublication
DEFAULT_COLOR_MODE=dark_editorial
